# Anthropic / LiteLLM — enables AI narratives and chat (optional; scan works without it)
ANTHROPIC_API_KEY=
LITELLM_MODEL=claude-sonnet-4-6

# NVD — optional; raises NVD rate limit from 5 to 50 requests / 30s
# Get a free key: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Max NVD calls per scan (default 10); extra packages resolve via OSV only
NVD_MAX_PER_SCAN=10
